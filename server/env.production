# ─────────────────────────────────────────
# Application
# ─────────────────────────────────────────
APP_ENV=production
APP_SECRET_KEY=CHANGE_ME_generate_with_python_secrets_token_hex_32
DEBUG=false
BASE_URL=https://api.yourdomain.com

# ─────────────────────────────────────────
# Database
# ─────────────────────────────────────────
POSTGRES_DB=dialbridge
POSTGRES_USER=dialbridge
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ─────────────────────────────────────────
# Redis
# ─────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# ─────────────────────────────────────────
# JWT
# ─────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─────────────────────────────────────────
# ElevenLabs
# ─────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_WEBHOOK_SECRET=your_elevenlabs_webhook_secret

# ─────────────────────────────────────────
# Groq (AI Agent Generation)
# ─────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ─────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com

# ─────────────────────────────────────────
# Google OAuth
# ─────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=

# ─────────────────────────────────────────
# Email (Brevo SMTP)
# ─────────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_user
SMTP_PASSWORD=your_brevo_smtp_password
MAIL_FROM_EMAIL=noreply@yourdomain.com
MAIL_FROM_NAME=DialBridge

# ─────────────────────────────────────────
# Integrations (leave blank if not used)
# ─────────────────────────────────────────
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GOOGLE_CAL_CLIENT_ID=
GOOGLE_CAL_CLIENT_SECRET=
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
