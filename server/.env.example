# Application
APP_ENV=development
APP_SECRET_KEY=changeme-generate-a-real-secret
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://dialbridge:password@localhost:5433/dialbridge

# Redis (for Celery background jobs)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ElevenLabs — workspace-level key is stored per workspace in the DB.
# This is only used for platform-level calls (e.g. listing available voices).
ELEVENLABS_PLATFORM_API_KEY=

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173
