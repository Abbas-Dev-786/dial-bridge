# Application
APP_ENV=development
APP_SECRET_KEY=changeme-generate-a-real-secret
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://dialbridge:password@localhost:5433/dialbridge

# Redis (for Celery background jobs)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ElevenLabs — single platform-level key.
# All workspaces share this account. Never expose to users.
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_WEBHOOK_SECRET=

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173

# Groq API — platform-level key for AI agent generation.
# This is NOT per-workspace. Never expose this to users.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=

# Email Settings (Brevo / SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_EMAIL=noreply@dialbridge.ai
MAIL_FROM_NAME=DialBridge
