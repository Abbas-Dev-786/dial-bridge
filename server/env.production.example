# ── Database ──────────────────────────────────────────────
POSTGRES_DB=dialbridge
POSTGRES_USER=dialbridge
POSTGRES_PASSWORD=change-me-strong-password-here

# ── Redis ─────────────────────────────────────────────────
REDIS_PASSWORD=change-me-redis-password-here

# ── Application ───────────────────────────────────────────
APP_ENV=production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=change-me-generate-with-secrets-token-hex-32

# ── URLs ──────────────────────────────────────────────────
# Your API domain (set up in Coolify)
BASE_URL=https://dialbridge-api.abbasbhanpura.tech
# Your frontend domain
FRONTEND_URL=https://app.yourdomain.com

# ── ElevenLabs ────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=

# ── Groq (AI Agent Generation) ────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Google OAuth ──────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=

# ── Email / SMTP ──────────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_EMAIL=noreply@yourdomain.com
MAIL_FROM_NAME=DialBridge

# ── Integrations (optional) ───────────────────────────────
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GOOGLE_CAL_CLIENT_ID=
GOOGLE_CAL_CLIENT_SECRET=
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
